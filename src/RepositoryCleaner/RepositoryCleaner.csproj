<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <AssemblyName>RepositoryCleaner</AssemblyName>
    <RootNamespace>RepositoryCleaner</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PackageId>repositorycleaner</PackageId>
    <Title>Repository Cleaner</Title>
    <Description>Cleans the packages and output files of large sets of repositories to save disk space.</Description>
    <PackageTags>repository cleaner disk space</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <UseWpf>true</UseWpf>
    <ExtrasEnableImplicitWinFormsReferences>true</ExtrasEnableImplicitWinFormsReferences>
  </PropertyGroup>
  
  <PropertyGroup>
    <!-- SonarQube requires a project guid -->
    <ProjectGuid>50E41855-2674-4723-BCD4-5AD8BC6449D5</ProjectGuid>
  </PropertyGroup>
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject />
    <NoWarn>$(NoWarn);SA1652</NoWarn>
    <ApplicationIcon>Resources\Icons\logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Catel.MVVM" Version="6.2.0" />
    <PackageReference Include="Catel.Fody" Version="7.0.0" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Humanizer" Version="3.0.10" />
    <PackageReference Include="MethodTimer.Fody" Version="3.2.3" PrivateAssets="all">
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Build" Version="18.7.*" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.8.*" />
    <PackageReference Include="Orc.CommandLine" Version="5.0.0" />
    <PackageReference Include="Orc.Controls" Version="5.4.1" />
    <PackageReference Include="Orc.LogViewer" Version="5.2.0" />
    <PackageReference Include="Orc.Notifications" Version="5.2.0" />
    <PackageReference Include="Orchestra.Core" Version="7.3.0" />
    <PackageReference Include="semver" Version="3.0.0" />
  </ItemGroup>

  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.explicit.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.mat.props')" />
  <Import Project="$(MSBuildProjectDirectory)\..\Directory.Build.shared.tools.props" Condition="Exists('$(MSBuildProjectDirectory)\..\Directory.Build.shared.tools.props')" />
</Project>
